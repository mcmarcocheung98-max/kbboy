# ── Required ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Get from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=

# Your personal Telegram user ID — message @userinfobot to get it
